/* ไฟล์เก็บโค้ดตกแต่งสีและหน้าตา UI (คล้าย CSS ของฝั่ง Web) */
/* ==========================================
   ธีม: สีขาวสบายตา (Pastel White Theme)
   อ้างอิงโทนสีพาสเทลจากตัวอย่างที่ผู้ใช้ส่งมา:
   ฟ้าพาสเทล #B6E3E9 / #AACCE2 / #789CCE, ม่วงพาสเทล #B19CD8 / #D9C4EC,
   ชมพูพาสเทล #FDAFAB / #FADEE1, พื้นหลังขาวสบายตา #FBFAF8
========================================== */

QWidget {
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 12px;
    color: #33415C;
    font-weight: bold;
    background-color: #FBFAF8;
}

QMainWindow, QDialog, QWidget#centralwidget {
    background-color: #FBFAF8;
}

/* ==========================================
   2. พื้นหลังฝั่งซ้าย (Input Panel)
========================================== */
QWidget#leftPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #D9F1F1;
}

QWidget#leftPanel QScrollArea,
QWidget#leftPanel QScrollArea > QWidget,
QWidget#leftPanel QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QLabel, QHBoxLayout, QVBoxLayout, QGridLayout {
    background-color: transparent;
}

/* แก้แผ่นสีเทาที่ซ้อนอยู่หลังช่องกรอกใน Frequency Settings / PPM Deviation
   (QWidget ลูกที่อยู่ใน QGroupBox ไม่ได้กำหนดสีพื้นหลังไว้ จึงโดนสี
   QWidget { background-color: #FBFAF8; } ทั่วไปบังคับใช้ กลายเป็นแผ่นสีเทา
   ซ้อนทับอยู่ในกล่องสีขาวของ QGroupBox) */
QGroupBox QWidget {
    background-color: transparent;
}

/* คืนสีขาวให้ช่อง Dropdown/Input ที่อยู่ใน QGroupBox
   เนื่องจากกฎ QGroupBox > QWidget ด้านบน specificity สูงกว่ากฎสีขาวเดิม
   ของ QComboBox/QLineEdit/QSpinBox/QDoubleSpinBox เลยไปทับให้โปร่งใสด้วย */
QGroupBox QComboBox, QGroupBox QLineEdit, QGroupBox QSpinBox,
QGroupBox QDoubleSpinBox, QGroupBox QTextEdit, QGroupBox QPlainTextEdit {
    background-color: #FFFFFF;
}

/* ==========================================
   3. กล่องจัดกลุ่ม (บล็อกเมนู)
========================================== */
QGroupBox, QWidget#leftPanel QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #D6E4F0;
    border-top: 2px solid #B19CD8;
    border-radius: 8px;
    margin-top: 32px;
    margin-bottom: 16px;
    padding: 20px 10px 12px 10px;
}

QGroupBox::title {
    color: #2C3A5C;
    font-size: 16px;
    font-weight: 900;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 5px 14px;
    background-color: #D9C4EC;
    border: 1px solid #C0AFE2;
    border-radius: 6px;
}

QGroupBox:disabled {
    background-color: #F4F5F7;
    border-color: #E7EAEF;
    border-top: 1px solid #E7EAEF;
}

QGroupBox:disabled::title {
    color: #A3ADC2;
    background-color: #EDEFF3;
    border: 1px solid #E7EAEF;
}

QLabel:disabled {
    color: #A3ADC2;
}

/* ==========================================
   4. ช่องป้อนข้อมูล (Inputs)
========================================== */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #AACCE2;
    border-radius: 6px;
    padding: 6px 10px;
    color: #2C3A5C;
    font-size: 13px;
    font-weight: bold;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #B19CD8;
    background-color: #F7F5FC;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    color: #A3ADC2;
    background-color: #F4F5F7;
    border: 1px solid #E7EAEF;
}

/* ==========================================
   Dropdown List
========================================== */
QComboBox {
    padding-right: 30px;
}
QComboBox::drop-down {
    background-color: #EAF3FA;
    border-left: 1px solid #AACCE2;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    width: 28px;
}
QComboBox::drop-down:disabled {
    background-color: transparent;
    border-left: none;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #2C3A5C;
    border: 1px solid #AACCE2;
    selection-background-color: #D9C4EC;
    selection-color: #2C3A5C;
    outline: none;
}

/* ==========================================
   SpinBox: ซ่อนปุ่ม "+" และ "-" ทิ้ง (ให้พิมพ์ค่าเองเท่านั้น)
   [แก้ไข] เดิม qproperty-buttonSymbols: 1 (UpDownArrows) บังคับให้ปุ่มโชว์
   เสมอผ่าน QSS ระดับ global — ทับค่าที่ตั้งไว้ใน setButtonSymbols() ฝั่ง
   Python (utils/helpers.py: NoScrollSpinBox/NoScrollDoubleSpinBox) เพราะ QSS
   ถูก apply ทีหลังตอน widget แสดงผลจริง เปลี่ยนเป็น 2 (NoButtons) ให้ตรงกัน
========================================== */
QSpinBox, QDoubleSpinBox {
    qproperty-buttonSymbols: 2;
    padding-right: 10px;
}

/* ==========================================
   ปุ่มกดทั่วไป และ โหมด (Single/Sweep)
========================================== */
QPushButton {
    background-color: #EAF3FA;
    color: #2C3A5C;
    border: 1px solid #AACCE2;
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #AACCE2;
    border-color: #789CCE;
    color: #1B2740;
}

QPushButton:checked {
    background-color: #B19CD8;
    color: #FFFFFF;
    border: 1px solid #9379C2;
}

QPushButton:disabled {
    background-color: #F4F5F7;
    color: #A3ADC2;
    border: 1px solid #E7EAEF;
}

QPushButton:checked:disabled {
    background-color: #E4DCF2;
    color: #B7AED0;
    border: 1px solid #D6C9EB;
}

/* ==========================================
   ปุ่ม OPEN / SHORT Correction (สีส้มพาสเทล)
========================================== */
QPushButton#btnOpenCorr, QPushButton#btnShortCorr {
    background-color: #FFD9A6;
    color: #5A3B00;
    border: 1px solid #F0B860;
}

QPushButton#btnOpenCorr:hover, QPushButton#btnShortCorr:hover {
    background-color: #FFC98A;
}

/* ==========================================
   ปุ่ม START / STOP
========================================== */
QPushButton#btnStart {
    background-color: #A8E6C1;
    color: #14532D;
    font-size: 16px;
    border: 1px solid #7FD9A0;
    font-weight: bold;
}
QPushButton#btnStart:hover {
    background-color: #8FDBAD;
}
QPushButton#btnStart:disabled {
    background-color: #E5E7EB;
    color: #A3ADC2;
}

QPushButton#btnStop {
    background-color: #FDAFAB;
    color: #7A1F1B;
    font-size: 16px;
    border: 1px solid #F58E89;
    font-weight: bold;
}
QPushButton#btnStop:hover {
    background-color: #FA9691;
}

/* ==========================================
   ปุ่มติ๊ก (Checkbox) แบบกล่องสี่เหลี่ยม
========================================== */
QCheckBox {
    spacing: 8px;
    color: #2C3A5C;
    font-weight: bold;
    background-color: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #AACCE2;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover {
    border: 1px solid #B19CD8;
}
QCheckBox::indicator:checked {
    background-color: #A8E6C1;
    border: 2px solid #7FD9A0;
}

QCheckBox:disabled {
    color: #A3ADC2;
}
QCheckBox::indicator:disabled {
    background-color: #F4F5F7;
    border: 1px solid #E7EAEF;
}
QCheckBox::indicator:checked:disabled {
    background-color: #E7EAEF;
    border: 1px solid #DCE1E8;
}

/* ==========================================
   ตาราง (Verify Dialog)
========================================== */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F3F8FB;
    color: #2C3A5C;
    gridline-color: #E7EAEF;
    border: 1px solid #E7EAEF;
}
QHeaderView::section {
    background-color: #D9F1F1;
    color: #2C3A5C;
    padding: 6px;
    border: 1px solid #C9E7E7;
    font-weight: bold;
}
QTableWidget::item:selected {
    background-color: #D9C4EC;
    color: #2C3A5C;
}

/* ==========================================
   หน้าจอ LCD (Measurement Result)
========================================== */
QGroupBox#lcdGroup {
    background-color: #F7FBFC;
    border: 1px solid #D6E4F0;
    border-top: 2px solid #789CCE;
}

QGroupBox#lcdGroup::title {
    background-color: #789CCE;
    color: #FFFFFF;
    border: 1px solid #6A8AC0;
    font-size: 16px;
    font-weight: 900;
}

QLabel#lblPriTitle, QLabel#lblSecTitle {
    color: #5B7FB5;
    font-weight: bold;
}

QLabel#lblPriVal, QLabel#lblSecVal {
    color: #2E5C8A;
    font-size: 32px;
    font-weight: bold;
}

/* ==========================================
   5. แถบเลื่อน (Scrollbar) — สีเหลืองเด่นชัด ให้ผู้ใช้เห็นชัดว่าเลื่อนดูข้อมูลเพิ่มได้
========================================== */
QScrollBar:vertical {
    background-color: #F0F3F6;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background-color: #FFE066;
    min-height: 30px;
    border-radius: 6px;
    border: 1px solid #F2C744;
}
QScrollBar::handle:vertical:hover {
    background-color: #FFEB99;
}
QScrollBar::handle:vertical:pressed {
    background-color: #F2C744;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #F0F3F6;
    height: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal {
    background-color: #FFE066;
    min-width: 30px;
    border-radius: 6px;
    border: 1px solid #F2C744;
}
QScrollBar::handle:horizontal:hover {
    background-color: #FFEB99;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #F2C744;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==========================================
   6. ส่วนตกแต่งเพิ่มเติมสำหรับฟีเจอร์ใหม่
========================================== */
QPushButton#btnVerify, QPushButton#btnClearData, QPushButton#btnSaveResult,
QPushButton#btnViewSaveResult, QPushButton#btnExportExcel {
    background-color: #AACCE2;
    color: #1B2740;
    border: 1px solid #789CCE;
    border-radius: 6px;
}
QPushButton#btnVerify:hover, QPushButton#btnClearData:hover, QPushButton#btnSaveResult:hover,
QPushButton#btnViewSaveResult:hover, QPushButton#btnExportExcel:hover {
    background-color: #95C8D7;
}

/* ==========================================
   7. สีส่วนของ Tab ตรงOutputฝั่งขวา
========================================== */
QTabBar::tab {
    background-color: #F0F3F6;
    color: #5A6B8C;
    border: 1px solid #E1E6EC;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 14px;
    margin-right: 2px;
    font-weight: bold;
}
QTabBar::tab:selected {
    background-color: #D9F1F1;
    color: #1B2740;
    border: 1px solid #AACCE2;
    border-bottom: none;
}
QTabBar::tab:hover:!disabled {
    background-color: #E7F3F3;
}
QTabBar::tab:disabled {
    background-color: #F7F8FA;
    color: #C0C7D3;
    border: 1px solid #EEF0F3;
    border-bottom: none;
}