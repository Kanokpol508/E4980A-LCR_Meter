/* ไฟล์เก็บโค้ดตกแต่งสีและหน้าตา UI (คล้าย CSS ของฝั่ง Web) */

/* ==========================================
   1. สีพื้นหลังของหน้าต่างหลัก (ฝั่งขวา)
========================================== */
QWidget {
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 12px;                 
    color: #ffffff;                                         /* สีตัวอักษรขาว */
    font-weight: bold;                                      /* บังคับให้ตัวหนังสือทุกส่วนดูหนาขึ้นกว่าปกติ */
}

QMainWindow, QDialog, QWidget#centralwidget {
    background-color: #2b1b4d;                              /* สีพื้นหลังกราฟและจอ LCD */
}

/* ==========================================
   2. พื้นหลังฝั่งซ้าย (Input Panel)
========================================== */
QWidget#leftPanel {
    background-color: #2b1b4d;                              /* พื้นหลังหลังกล่อง */
    border-right: 1px solid #4c307a;                        /* เส้นคั่นบางๆ ระหว่างฝั่งซ้ายและขวา */
}

QWidget#leftPanel QScrollArea,
QWidget#leftPanel QScrollArea > QWidget,
QWidget#leftPanel QScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

QLabel, QHBoxLayout, QVBoxLayout, QGridLayout {
    background-color: transparent;
}

/* ==========================================
   3. กล่องจัดกลุ่ม (บล็อกเมนู)
========================================== */
QGroupBox, QWidget#leftPanel QGroupBox {
    background-color: #172445;                              
    border: 1px solid #2d4578;                              
    border-top: 2px solid #8b5cf6;                          
    border-radius: 6px;
    margin-top: 32px;                                       
    margin-bottom: 16px;                                    
    padding: 20px 10px 12px 10px;                           
}

QGroupBox::title {
    color: #ffffff;                                         
    font-size: 16px;                                        
    font-weight: 900;                                       
    subcontrol-origin: margin;
    subcontrol-position: top left; 
    left: 12px;                      
    padding: 5px 14px;                                      
    background-color: #0066CC;                              
    border: 1px solid #3b82f6;                              
    border-radius: 4px;              
}

QGroupBox:disabled {
    background-color: #0a101f;
    border-color: #172445;
    border-top: 1px solid #172445;
}

QGroupBox:disabled::title {
    color: #475569;
    background-color: #2b1b4d;                              
    border: 1px solid #172445;
}

QLabel:disabled {
    color: #475569;
}

/* ==========================================
   4. ช่องป้อนข้อมูล (Inputs)
========================================== */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #090e1f;                              
    border: 1px solid #3b82f6;                              
    border-radius: 4px;
    padding: 6px 10px;                
    color: #ffffff;                                         
    font-size: 13px;                 
    font-weight: bold;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid #8b5cf6;                              
    background-color: #0f1836;       
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: #475569;
    background-color: #0a101f;
    border: 1px solid #172445;
}

/* ==========================================
   Dropdown List
========================================== */
QComboBox {
    padding-right: 30px;
}
QComboBox::drop-down {
    background-color: #121d38;                              
    border-left: 1px solid #3b82f6;                         
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    width: 28px;
}
QComboBox::drop-down:disabled {
    background-color: transparent;                          
    border-left: none;                                      
}

/* ==========================================
   SpinBox: สัญลักษณ์ "+" และ "-"
========================================== */
QSpinBox, QDoubleSpinBox {
    qproperty-buttonSymbols: 1; 
    padding-right: 10px;             
}

/* ==========================================
   ปุ่มกดทั่วไป และ โหมด (Single/Sweep)
========================================== */
QPushButton {
    background-color: #121d38;                              
    color: #ffffff;                  
    border: 1px solid #3b82f6;       
    border-radius: 4px;
    padding: 6px 12px;               
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2563eb;                              
    border-color: #60a5fa;
    color: white;
}

QPushButton:checked {
    background-color: #8b5cf6;                              
    color: white;
    border: 1px solid #a855f7;       
}

QPushButton:disabled {
    background-color: #2b1b4d;       
    color: #475569;
    border: 1px solid #172445;
}

QPushButton:checked:disabled {
    background-color: #172445;       
    color: #64748b;
    border: 1px solid #2d4578;
}

/* ==========================================
   ปุ่ม OPEN / SHORT Correction (สีส้ม)
========================================== */
QPushButton#btnOpenCorr, QPushButton#btnShortCorr {
    background-color: #FF9900;       /* สีส้ม */
    color: #000000;                  /* ตัวอักษรดำ */
    border: 1px solid #cc7a00;
}

QPushButton#btnOpenCorr:hover, QPushButton#btnShortCorr:hover {
    background-color: #ffaa33;       /* สีส้มสว่างขึ้นตอนชี้เมาส์ */
}

/* ==========================================
   ปุ่ม START / STOP
========================================== */
QPushButton#btnStart {
    background-color: #10b981;                              
    color: white;
    font-size: 16px;
    border: none;
    font-weight: bold;
}
QPushButton#btnStart:hover {
    background-color: #059669;       
}
QPushButton#btnStart:disabled {
    background-color: #606671;                              
    color: #ffffff;
}

QPushButton#btnStop {
    background-color: #ef4444;                              
    color: white;
    font-size: 16px;
    border: none;
    font-weight: bold;
}
QPushButton#btnStop:hover {
    background-color: #dc2626;
}

/* ==========================================
   ปุ่มติ๊ก (Checkbox) แบบกล่องสี่เหลี่ยม
========================================== */
QCheckBox {
    spacing: 8px;
    color: #ffffff;
    font-weight: bold;
    background-color: transparent;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #3b82f6;       
    background-color: #090e1f;
}
QCheckBox::indicator:hover {
    border: 1px solid #8b5cf6;                              
}
QCheckBox::indicator:checked {
    background-color: #10b981;                              
    border: 2px solid #059669;
}

QCheckBox:disabled {
    color: #475569;
}
QCheckBox::indicator:disabled {
    background-color: #0a101f;
    border: 1px solid #172445;
}
QCheckBox::indicator:checked:disabled {
    background-color: #172445;
    border: 1px solid #2d4578;
}

/* ==========================================
   ตาราง (Verify Dialog)
========================================== */
QTableWidget {
    background-color: #040814;
    alternate-background-color: #0a101f; 
    color: #ffffff;
    gridline-color: #172445;
    border: 1px solid #172445;
}
QHeaderView::section {
    background-color: #172445;                              
    color: #38bdf8;                                         
    padding: 6px;
    border: 1px solid #172445;
    font-weight: bold;
}
QTableWidget::item:selected {
    background-color: #8b5cf6;                              
    color: white;
}

/* ==========================================
   หน้าจอ LCD (Measurement Result)
========================================== */
QGroupBox#lcdGroup {
    background-color: #000000;                              
    border: 1px solid #172445;
    border-top: 2px solid #38bdf8;                          
}

QGroupBox#lcdGroup::title {
    background-color: #0066CC;
    color: #ffffff;
    border: 1px solid #3b82f6;
    font-size: 16px;
    font-weight: 900;
}

QLabel#lblPriTitle, QLabel#lblSecTitle {
    color: #00FF33;                                         
    font-weight: bold;
}

QLabel#lblPriVal, QLabel#lblSecVal {
    color: #00FF33;                                         
    font-size: 32px;                 
    font-weight: bold;
}

/* ==========================================
   5. แถบเลื่อน (Scrollbar)
========================================== */
QScrollBar:vertical {
    background-color: rgba(10, 16, 31, 0.4);                
    width: 10px;                                            
    margin: 0px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background-color: #FF9900;                              
    min-height: 30px;                                       
    border-radius: 5px;                                     
}
QScrollBar::handle:vertical:hover {
    background-color: #FF9933;                              
}
QScrollBar::handle:vertical:pressed {
    background-color: #FFA500;                              
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* ==========================================
   6. ส่วนตกแต่งเพิ่มเติมสำหรับฟีเจอร์ใหม่
========================================== */
QPushButton#btnVerify {
    background-color: #3b82f6;       
    color: white;
    border: 1px solid #2563eb;
    border-radius: 4px;
}

QPushButton#btnVerify:hover {
    background-color: #60a5fa;       
}

/* ==========================================
   7. ส่วนแสดงสถิติข้างกราฟ (Stat Panel)
========================================== */
QGroupBox#statGroup {
    background-color: #172445; 
}

QLabel#lblStatTitle {
    color: #ffffff; 
    font-size: 13px;         /* ขยายขนาดหัวข้อให้อ่านง่ายขึ้น (เดิม 11px) */
    margin-top: 16px;        /* เว้นช่องไฟด้านบนเพื่อให้แต่ละกลุ่มห่างกันชัดเจน */
}

QLabel#lblStatValue {
    color: #FF9900; 
    font-size: 18px;         /* ขยายขนาดตัวเลขให้ใหญ่และชัดเจน (เดิม 14px) */
    font-weight: bold;
    margin-bottom: 4px;      /* เพิ่มช่องไฟเล็กน้อยด้านล่างตัวเลข */
}